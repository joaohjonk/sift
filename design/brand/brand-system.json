  "sections": {
    "business_truth": {
      "faces": {
        "value": "Two faces, one engine. Sift Page in front: the machine finds every piece in a creator's posts, she keeps a few, the page is built in minutes. Sift Record behind: contract, post check, invoice and payment for her, her agency and the brand.",
        "input_class": "FACT",
        "sources": [
          {
            "kind": "official_asset",
            "ref": "assets/official/BRAND.md#00",
            "quote": "Two faces, one engine. The page, in front ... The record, behind: the back office that understands, verifies and receives every deal.",
            "captured_at": "2026-09-29",
            "by": "brand-import"
          }
        ],
        "confidence": "high",
